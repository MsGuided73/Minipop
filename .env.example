# Copy this file to .env and fill in the values.
# Required: Supabase project credentials (anon key is fine — designed to be public)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional: API auth header guarding /api/* endpoints (leave blank to disable)
POPPY_API_KEY=

# Optional: Apify token for Tier-3 YouTube transcript fallback
APIFY_API_TOKEN=

# Optional: server port (defaults to 3000)
PORT=3000
